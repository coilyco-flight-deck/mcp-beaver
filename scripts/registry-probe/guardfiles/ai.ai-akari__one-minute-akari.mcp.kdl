// ai.ai-akari/one-minute-akari
// Generated from the MCP registry and a live tools/list.
// 4 tools: 2 declared read-only, 2 declared mutating,
// 0 undeclared. Only declared read-only tools are exposed.
instructions {
    text "A free one-minute reset for people, delivered by AI, with no account or personal data."
}
mcp-upstream "ai.ai-akari/one-minute-akari" {
    url "https://ai-akari.ai/mcp"
    transport streamable-http
    // Machine-readable, so a consumer can filter on it rather than
    // parse the comments above.
    annotation-coverage declared annotated=4 silent=0
    // readOnlyHint: true, declared by the upstream
    can audit_result_claim
    can list_one_minute_states
 // Not exposed: 2 declared mutating, 0 undeclared.
    // Names deliberately omitted, see annotation-coverage above.
}
