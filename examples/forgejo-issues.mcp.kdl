// forgejo-issues.mcp.kdl - the "hello world" ward-mcp spec.
//
// The body is cli-guard Guardfile grammar (L2). The `.mcp.kdl` suffix marks it
// as a ward-mcp target - a long-lived HTTP/SSE MCP server, built to a Docker
// image and run on k3s - and keeps it out of cli-guard's `*.guardfile.kdl`
// CLI-discovery glob, the way `.fleet.kdl` partitions the fleet dialect. This
// file is served over the network, never spawned per-session over stdio.
//
// ward-mcp has NO relation to the ward codebase. It drives cli-guard's
// specverb/guardfile/codegen engine directly. cli-mcp is read as a CODE
// REFERENCE only; ward-mcp implements its own SSE/HTTP MCP server, it does not
// depend on cli-mcp.
//
// The magic is what is NOT here: no tool definitions, no input schemas. Each
// `can` grant IS one MCP tool; its input schema is derived by the engine from
// the pruned OpenAPI operation (path params, query params, body fields). You
// author policy, not plumbing. The grants that would gate a CLI gate the MCP
// tools instead: `never delete issue` means no `delete_issue` tool is minted.
wrap forgejo-issues ops forgejo {
    spec forgejo.swagger.v1.json
    base-url "forgejo.coilysiren.me/api/v1"

    // Secret resolved at RUN time through cli-guard's value-provider registry,
    // never baked into the image. On k3s this env is a mounted Secret.
    auth header-token {
        header Authorization
        prefix "token "
        value env FORGEJO_TOKEN
    }

    // Scope gate: every {owner} path leaf must name a coily* owner. Enforced on
    // the MCP surface exactly as cli-guard enforces it on a CLI.
    restrict owner matches coily*

    // ---- the exposed surface ----------------------------------------------
    // verb + resource -> operationId by convention -> one MCP tool.
    // Tool name is the verb_resource pair; input schema is auto-derived.

    can create issue     // -> tool `create_issue`  (POST /repos/{owner}/{repo}/issues)
    can get issue        // -> tool `get_issue`     (GET  .../issues/{index})
    can list issue       // -> tool `list_issues`   (GET  .../issues)
    can comment issue    // -> tool `comment_issue` (POST .../issues/{index}/comments)

    can close issue {
        body state=closed   // fixed-body toggle: tool sends exactly {"state":"closed"}
    }

    // Denied, so the tool is never minted. A deny beats an allow.
    never delete issue {
        message "issue deletion is irreversible; close it instead"
    }
}
