// forgejo-issues.mcp.kdl - the worked "hello world" ward-mcp spec.
//
// The body is the FROZEN ward-mcp inline grammar (ward-mcp#6), parsed by
// umbra's `opcore.ParseInline` - stated directly from KDL, with no vendored
// OpenAPI or lock file in the build. The `.mcp.kdl` suffix marks this as a
// ward-mcp target - the interior of a Docker image that serves an HTTP/SSE MCP
// server - and keeps it out of umbra's CLI-discovery glob. This spec
// configures ONLY the image interior. Exposing the container (k3s Service,
// route, Secret wiring) is the deploy repo's job, never this file's.
//
// ward-mcp has NO relation to the ward codebase. It drives umbra's opcore
// engine directly. cli-mcp is read as a CODE REFERENCE only; ward-mcp
// implements its own SSE/HTTP MCP server and does not depend on cli-mcp.
//
// The magic is what is NOT here: no separate tool definitions or schemas. Each
// `can` grant IS one MCP tool named `verb_resource`; its input schema is
// derived by opcore from the grant's `path`/`query`/`body`. ward-mcp derives
// the human title, safety annotations, and structured `{result: ...}` output
// contract from the same operation descriptor.
wrap ward mcp forgejo {
    base-url "forgejo.coilysiren.me/api/v1"

    // Secret resolved at RUN time through umbra's value-provider registry
    // (the `env` builtin), never baked into the image. How the env reaches the
    // container is the deployer's concern, outside this spec.
    auth header-token {
        header "Authorization"
        prefix "token "
        value env "FORGEJO_TOKEN"
    }

    // Scope gate: every {owner} path leaf must match a coilyco-* / kai owner.
    // Enforced on the MCP surface exactly as umbra enforces it on a CLI.
    restrict owner matches "coilyco-*" "kai"

    // ---- the exposed surface ----------------------------------------------
    // verb + resource -> HTTP method by convention -> one MCP tool.
    // Tool name is verb_resource; input schema is derived from path/query/body.

    // The flat `body "title" "body"` shorthand mints optional string fields
    // and nothing else. A `body { ... }` block is what carries required flags
    // and typed arrays - which is how labels ride along on creation instead of
    // costing a second `add issue-label` call per issue.
    //
    // items="integer" because Forgejo's CreateIssueOption takes label IDs.
    // Declaring them as strings parses fine and then silently labels nothing,
    // since the ids arrive quoted. `milestone` and `assignees` have the same
    // shape if a deployment wants them.
    can create issue {
        path "/repos/{owner}/{repo}/issues"   // POST -> tool `create_issue`
        body {
            field "title" type="string" required=#true
            field "body" type="string"
            array "labels" items="integer"
        }
    }
    can get issue {
        path "/repos/{owner}/{repo}/issues/{index}"   // GET -> tool `get_issue`
    }
    can list issue {
        path "/repos/{owner}/{repo}/issues"   // GET -> tool `list_issue`
        query "state"
    }
    can comment issue {
        path "/repos/{owner}/{repo}/issues/{index}/comments"   // POST -> `comment_issue`
        body "body"
    }
    can close issue {
        path "/repos/{owner}/{repo}/issues/{index}"   // PATCH -> `close_issue`
        set state="closed"   // fixed-body toggle: tool sends exactly {"state":"closed"}
    }

    // No `delete issue` grant is written, so no `delete_issue` tool is ever
    // minted. Deny-by-absence IS the deletion guard in the frozen grammar: the
    // surface is exactly the grants, and an unwritten grant is an absent tool.
}
