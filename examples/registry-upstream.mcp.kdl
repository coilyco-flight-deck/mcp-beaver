// registry-upstream.mcp.kdl - a hosted MCP server, proxied behind an exact
// allowlist, stated as a guardfile rather than as `serve-upstream` flags.
//
// `mcp-beaver pull ac.tandem/docs-mcp` wrote the body from the registry entry
// and a live tools/list on 2026-09-01, 18:17 UTC. The allowlist is the upstream's own
// answer: only tools it declares `readOnlyHint: true` are granted, and the
// `annotation-coverage` marker records that six of its thirteen tools declare
// nothing. Nothing about the tools is restated here, because the proxy
// snapshots their contracts at connect time and fails closed on drift.

instructions {
    text "Search the published Tandem docs index. Read-only: the cache tools this server also serves are not exposed."
}

wrap mcp upstream "ac.tandem/docs-mcp" {
    url "https://tandem.ac/mcp"
    transport streamable-http
    annotation-coverage partial annotated=7 silent=6

    can "search_docs"
    can "get_doc"
    can "get_start_path"
    can "recommend_next_docs"
    can "answer_how_to"
    can "get_tandem_guide"
    can "get_docs_cache_status"
}
