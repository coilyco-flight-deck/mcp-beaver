// steam-storefront.mcp.kdl - the public, unauthenticated storefront half of
// steam-ops, as a guardfile (mcp-beaver#52).
//
// Separate from examples/steam-web-api.mcp.kdl because the storefront is a
// different host, and one guardfile has one `base-url`. Two servers, two
// releases. That is the intended shape, not a workaround: the two halves have
// different credentials, different risk, and different rate profiles.
//
// This one holds NO account credential at all and reads only public data.

// The storefront publishes no limit and is not an API you are invited to
// hammer. One request per second is a courtesy rate, not a measured ceiling.
rate-limit "1/1s"

wrap ward mcp steam-storefront {
    base-url "store.steampowered.com/api"

    // The storefront takes no credential, and `auth none` is how that is
    // stated (umbra v0.154.0). This used to send a literal placeholder,
    // because the grammar required a scheme and offered no way to decline one.
    // That was not the harmless stand-in it looked like: reddit answers a
    // placeholder bearer token with 403 while serving the same request
    // unauthenticated, which is what mcp-beaver#51 spent a diagnosis on.
    auth none

    can get store_app_details {
        path "/appdetails"
        describe "Fetch public storefront metadata for ONE Steam app by id - name, description, release date, price, genres. Public data only: does NOT read any account, library, or ownership state, and does NOT search. Use get_store_search_results to find an appid from a name."
        // Steam spells it `appids` even for a single lookup; `upstream=` maps
        // the readable local name onto the wire name.
        query "appid" upstream="appids"
        // Storefront pricing and availability are region-dependent, so this is
        // a real input rather than decoration. Unset means Steam's own default.
        query "country_code" upstream="cc"
    }

    can get store_search_results {
        path "/storesearch"
        describe "Search the public Steam storefront by name and return a small result set with appids. The lookup step before get_store_app_details. Public data only: does NOT read any account or library state."
        // Named `term`, not `query`: `query` is one of opcore's reserved
        // engine flag names (with dry-run, output, body-file) and fails
        // closed. The bespoke server calls this parameter `query`, so this is
        // the one caller-visible difference in the whole migration.
        query "term"
        query "country_code" upstream="cc"
    }
}
