// steam-web-api.mcp.kdl - the authenticated Steam Web API half of steam-ops

rate-limit "1/1s"

pin "get_owned_games" {
    query "include_appinfo" literal "1"
    query "include_played_free_games" literal "1"
}

wrap ward mcp steam-web-api {
    base-url "api.steampowered.com"

    // Steam authenticates with `?key=`, which is exactly this scheme.
    auth query-param {
        param "key" {
            value env "STEAM_API_KEY"
        }
    }

    can get owned_games {
        path "/IPlayerService/GetOwnedGames/v1/"
        describe "THINGS"
    }

    can get recently_played {
        path "/IPlayerService/GetRecentlyPlayedGames/v1/"
        describe "STUFF"
    }
}
