// guardfile-siblings.mcp.kdl - the worked reference for the nodes that ride
// BESIDE `wrap`: `server-info`, `withhold`, `confirm`, `resource`, `prompt`.
//
// `opcore.ParseInline` reads only the `wrap` node, so none of these touch the
// frozen inline grammar or the umbra pin. Every one fails closed. All are
// opt-in except `server-info`, which is on by default. See docs/DESIGN.md.

// One read-only tool reporting this server's own shape. Also the liveness
// probe clients lost when MCP 2026-07-28 removed the protocol-level `ping`.
//
// Stating this node changes nothing - it is on by default, and it is written
// out here to be read rather than to switch anything on. Use
// `server-info name="status"` to rename the tool, or `server-info disabled`
// to drop it.
server-info

// State a verb that is left out ON PURPOSE, so an agent stops inferring from
// silence. Absence otherwise means four things at once - withheld by policy,
// unimplemented, not offered upstream, or simply not matched by the agent's
// search - and the guesses go wrong in both directions. The stub appears in
// discovery, refuses every call, and reaches no upstream. Naming a tool this
// spec DOES mint is an error.
withhold "delete_thing" {
    reason "Deletion is withheld on this surface: the upstream has no undo, and nothing here needs it."
    alternative "create_thing"
}

// Gate the one mutation behind a Multi Round-Trip Request. The first call
// returns an input request instead of acting; the tool runs only on a retry
// carrying an explicit accept. Named by PROJECTED TOOL NAME, not by grant.
confirm "create_thing" message="This creates a thing upstream. Continue?"

// Static content, served on resources/read and rendered as an `@` mention in
// Claude Code. Inline only: a resource that proxied an upstream read would be
// a second egress path beside the grants.
resource "oncall-runbook" uri="ward://runbook/oncall" mime="text/markdown" {
    description "First response when this upstream starts 5xx-ing"
    text "1. Call ward_mcp_info and confirm the pod is serving its tools."
    text "2. Check the upstream's own status page before touching the pod."
    text "3. Escalate rather than retrying a write that already 5xx'd."
}

// A message template, served on prompts/get and rendered as a slash command in
// Claude Code. `{service}` is substituted from the argument; omitting a
// required argument is an error rather than an empty substitution.
prompt "triage" title="Triage an incident" {
    description "Walk the on-call first-response steps for this upstream"
    argument "service" description="Which service is failing" required=#true
    argument "since" description="How far back to look, e.g. 1h"
    text "You are triaging {service}."
    text "Read ward://runbook/oncall before taking any action."
    text "Look back {since} and report what you find before changing anything."
}

wrap ward mcp things {
    base-url "things.example/api/v1"

    auth bearer {
        value env "THINGS_API_TOKEN"
    }

    restrict owner matches "coilyco-*"

    // `describe` overrides the derived "Use this when the user wants to get
    // thing through the configured upstream service." Worth authoring whenever
    // a server ships a tool a model could confuse with a neighbour: say what
    // the tool covers AND what it does not, so the model can rule it out
    // rather than guess. Absent, the derived sentence still applies.
    can get thing {
        path "/owners/{owner}/things/{id}"
        describe "Fetch one thing by id, with its metadata. Returns the record only - does NOT create or modify anything; use create_thing for that."
    }

    can create thing {
        path "/owners/{owner}/things"
        body {
            field "title" type="string" required=#true
        }
    }
}
